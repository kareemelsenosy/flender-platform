# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev):
DATABASE_URL=sqlite:///./flender.db

# PostgreSQL (production — Neon, Supabase, Railway, or Vercel Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
APP_BASE_URL=http://localhost:8000
EMAIL_VERIFICATION_REQUIRED=false
INTERNAL_API_ENABLED=false

# ── File storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output

# On Vercel (/tmp is the only writable dir):
# UPLOAD_DIR=/tmp/uploads
# OUTPUT_DIR=/tmp/output

# ── AI / Search ───────────────────────────────────────────────────────────────
CLAUDE_API_KEY=
GEMINI_API_KEY=
GOOGLE_SEARCH_KEY=
GOOGLE_CSE_ID=

# ── Docker Compose: Order Sheet platform ──────────────────────────────────────
# Password for the bundled Postgres "db" service (used by docker-compose).
POSTGRES_PASSWORD=change-me

# ── Docker Compose: Social Media Tracker (SMT) ────────────────────────────────
# SMT is served at ordersheet.flendergroup.com/smt (same domain, same login).
# It runs in its own isolated Postgres + MinIO containers.
SMT_DB_PASSWORD=change-me-too
MINIO_ROOT_USER=smtadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
SMT_S3_BUCKET=smt-uploads

# ── Operations OS: supplier email intake ──────────────────────────────────────
# n8n posts the forwarded supplier email to POST /api/intake/email with this
# key in an X-Intake-Key header. Leave EMPTY to keep the endpoint disabled —
# it returns 404 until a key is set, so it can never be left open by accident.
# Generate one with:  openssl rand -hex 32
INTAKE_API_KEY=
# Which account owns collections that arrive by email. Falls back to the first
# active user when unset.
INTAKE_OWNER_EMAIL=
# Per-attachment size cap in MB. Image packages are the large ones.
INTAKE_MAX_FILE_MB=500
